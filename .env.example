# BG Opportunity Radar settings. Copy this file to ".env" and fill in the values.

# Public web address of the radar (used in email links). No slash at the end.
SITE_URL=https://radar.barrgazetas-toolkit.co.uk

# Port the radar listens on (put a web server / reverse proxy with HTTPS in front of it).
PORT=8080

# Where opportunities and subscribers are stored (a folder; back it up with the server).
DATA_DIR=./data

# How often to check the sources, in minutes.
CRAWL_INTERVAL_MINUTES=30

# ---- Email for the Monday briefing: fill in ONE of the two options ----
# The "from" address (must be allowed to send through the option you choose)
MAIL_FROM=BG Opportunity Radar <radar@barrgazetas.com>

# Option A - the company's own mail server (Microsoft 365, Google Workspace, Exchange...)
# Microsoft 365 example: SMTP_HOST=smtp.office365.com  SMTP_PORT=587  (user = the sending mailbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Option B - Resend (resend.com). Leave SMTP_HOST empty to use this.
RESEND_API_KEY=

# Only if the server reaches the internet through a proxy:
# HTTPS_PROXY=http://proxy.company.local:8080
